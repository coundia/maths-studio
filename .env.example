# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =====================================================================
# PALETTE DE COULEURS (mode clair et mode sombre)
# =====================================================================
# Chaque variable est la couleur pivot (nuance 500) d'un role. Toute la rampe
# 50 -> 950 en est derivee automatiquement en conservant l'echelle de
# luminosite calibree pour le contraste : la teinte change, la lisibilite non.
# Format accepte : #rgb ou #rrggbb. Laisser vide pour garder la valeur par defaut.
# Apres modification, relancez le serveur de developpement.

# Gris de l'interface : fonds, bordures, textes secondaires.
VITE_THEME_NEUTRAL="#62748e"
# Couleur principale : actions, validation, mise en avant des cours (Indigo).
VITE_THEME_PRIMARY="#6366f1"
# Couleur d'accent : navigation, etapes, elements interactifs.
VITE_THEME_ACCENT="#615fff"
# Couleur d'information : indices, rappels, annotations.
VITE_THEME_INFO="#00a6f4"
# Couleur d'avertissement : attention, prerequis, corrections.
VITE_THEME_WARNING="#fd9a00"
# Couleur d'erreur : reponses fausses, messages d'echec.
VITE_THEME_DANGER="#fb2c36"
# Couleur de mise en avant : figures geometriques secondaires.
VITE_THEME_HIGHLIGHT="#e12afb"

# --- Fonds et textes ---------------------------------------------------
# Mode clair
VITE_THEME_LIGHT_CANVAS="#f8fafc"
VITE_THEME_LIGHT_SURFACE="#ffffff"
VITE_THEME_LIGHT_INK="#0f172b"
# Mode sombre
VITE_THEME_DARK_CANVAS="#0b1120"
VITE_THEME_DARK_SURFACE="#0f172b"
VITE_THEME_DARK_INK="#f1f5f9"

# --- Garde-fous d'accessibilite ----------------------------------------
# Contraste WCAG minimum pour le texte courant (AA = 4.5, AAA = 7).
# Toute couleur de texte en dessous de ce seuil est eclaircie ou assombrie
# automatiquement jusqu'a l'atteindre.
VITE_THEME_MIN_CONTRAST="4.5"
# Contraste minimum pour le texte secondaire et les bordures d'interface.
VITE_THEME_MIN_CONTRAST_UI="3"

# Theme applique avant tout choix de l'utilisateur : light, dark ou system.
VITE_THEME_DEFAULT_MODE="system"
